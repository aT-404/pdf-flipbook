{
  "name": "pdf-flipbook",
  "version": "1.0.0",
  "private": true,
  "description": "Open any PDF as a flipbook: two pages at a time, swipe to turn pages.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev",
    "build": "node scripts/copy-pdfjs-assets.mjs && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
